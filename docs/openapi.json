{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Knowledge Assistant",
    "version": "0.0.1",
    "description": "API educativa de IA con Express, TypeScript, MOCK y OpenRouter."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Servidor local del laboratorio"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Estado de la aplicación"
    },
    {
      "name": "Assistant",
      "description": "Consultas al asistente de IA"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Consultar estado de la API",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ask": {
      "post": {
        "tags": [
          "Assistant"
        ],
        "summary": "Enviar una pregunta al asistente",
        "description": "Genera una respuesta en modo MOCK u OpenRouter.",
        "operationId": "askAssistant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              },
              "example": {
                "question": "¿Qué es una API REST?"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta del asistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Cuerpo HTTP demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor remoto no disponible o modelo gratuito no verificado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/extract": {
      "post": {
        "tags": [
          "Structured Extraction"
        ],
        "summary": "Extraer una actividad académica",
        "description": "Utiliza OpenRouter y valida el JSON generado mediante Zod.",
        "operationId": "extractAcademicActivity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              },
              "example": {
                "text": "Desarrollar una API REST con Express y TypeScript. Dificultad media. Duración estimada: 5 horas.",
                "mode": "structured"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracción completada y validada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ExtractBadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ExtractUnprocessable"
          },
          "502": {
            "$ref": "#/components/responses/ExtractBadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ExtractUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/ExtractTimeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "mode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "openrouter"
            ]
          }
        }
      },
      "AskRequest": {
        "type": "object",
        "required": [
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000,
            "description": "Pregunta del usuario"
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "promptTokens",
          "completionTokens"
        ],
        "properties": {
          "promptTokens": {
            "type": "integer",
            "minimum": 0
          },
          "completionTokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AskResult": {
        "type": "object",
        "required": [
          "answer",
          "mode",
          "model",
          "usage"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "openrouter"
            ]
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AskResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AskResult"
          },
          "meta": {
            "type": "object",
            "required": [
              "requestId"
            ],
            "properties": {
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ExtractRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2500
          },
          "mode": {
            "type": "string",
            "enum": [
              "json_mode",
              "structured"
            ],
            "default": "structured"
          },
          "model": {
            "type": "string",
            "description": "ID de un modelo gratuito compatible"
          }
        }
      },
      "ExtractedActivity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "topics",
          "difficulty",
          "estimatedHours",
          "deadline"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 450
          },
          "topics": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "baja",
              "media",
              "alta",
              "no_especificada"
            ]
          },
          "estimatedHours": {
            "type": "number",
            "nullable": true
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "ExtractUsage": {
        "type": "object",
        "required": [
          "promptTokens",
          "completionTokens",
          "totalTokens"
        ],
        "properties": {
          "promptTokens": {
            "type": "integer",
            "nullable": true
          },
          "completionTokens": {
            "type": "integer",
            "nullable": true
          },
          "totalTokens": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ExtractResponse": {
        "type": "object",
        "required": [
          "model",
          "mode",
          "data",
          "usage"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "json_mode",
              "structured"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/ExtractedActivity"
          },
          "usage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExtractUsage"
              }
            ],
            "nullable": true
          }
        }
      },
      "ExtractError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ExtractBadRequest": {
        "description": "Error de validación de entrada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ExtractError"
            }
          }
        }
      },
      "ExtractUnprocessable": {
        "description": "Modelo no disponible o incompatible",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ExtractError"
            }
          }
        }
      },
      "ExtractBadGateway": {
        "description": "Respuesta inválida del proveedor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ExtractError"
            }
          }
        }
      },
      "ExtractUnavailable": {
        "description": "Proveedor o configuración no disponible",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ExtractError"
            }
          }
        }
      },
      "ExtractTimeout": {
        "description": "Tiempo de espera agotado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ExtractError"
            }
          }
        }
      }
    }
  }
}
