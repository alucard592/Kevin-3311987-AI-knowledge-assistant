{
  "name": "ai-knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "API de asistente de conocimiento respaldada por OpenRouter",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:mock": "vitest run",
    "test:integration": "vitest run tests/api.test.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "prettier": "^3.3.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  }
}
